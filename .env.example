# Copy to .env (Docker) or export in your shell. Nothing here is required for local development.

# --- API (apps/api) ---
# PostgreSQL. Leave unset to use the embedded database in .data/pglite.
DATABASE_URL=
API_PORT=4000
# Where people open the web app (used in email links).
APP_URL=http://localhost:3000
# Shared secret between the web server and the API. Required in production.
API_INTERNAL_KEY=
# Email. Without POSTMARK_TOKEN, emails are kept in the outbox table and never sent.
POSTMARK_TOKEN=
EMAIL_FROM=BillingEase <hello@example.com>
# Attachments (photos and PDFs on expenses and bills).
STORAGE_DIR=.data/files
# Ask (AI answers). Without a key, Ask explains that it isn't set up.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5-5
# Fix "today" for demos and tests (YYYY-MM-DD).
BILLINGEASE_TODAY=

# --- Web (apps/web) ---
API_URL=http://127.0.0.1:4000

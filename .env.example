# Copy to .env (Docker) or export in your shell. Nothing here is required for local development.

# --- API (apps/api) ---
# PostgreSQL. Leave unset to use the embedded database in .data/pglite.
DATABASE_URL=
API_PORT=4000
# Where people open the web app (used in email links).
APP_URL=http://localhost:3000
# Shared secret between the web server and the API. Required in production.
API_INTERNAL_KEY=
# Exchange rates for quotes, invoices, bills and expenses in another currency. Daily rates come
# from the free currency-api (jsDelivr / Cloudflare), cached per day. Set to off to have people
# type every rate themselves.
FX_RATES=on

# Sign in with Google. Create an OAuth client (type "Web application") in the Google Cloud console
# under APIs & Services → Credentials, and add <APP_URL>/auth/google/callback as an authorised
# redirect URI, exactly (e.g. https://billingease.app/auth/google/callback: same scheme, no
# trailing slash, www only if people use www). Google sends the browser there, to the web app,
# never to the API: the web app passes the code to the API over API_URL. Set APP_URL on the web
# app too (not only the API), or GOOGLE_REDIRECT_URI to choose the address outright. Leave both unset to hide the Google button. Both the API and the web app read
# GOOGLE_CLIENT_ID; only the API needs the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the exact redirect URI, when it isn't <APP_URL>/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Email. SMTP (any mail server, e.g. Stalwart) when SMTP_HOST is set, else Postmark when
# POSTMARK_TOKEN is set. With neither, emails are kept in the outbox table and never sent.
# EMAIL_FROM must be an address the SMTP account may send as. See docs/DEPLOY-DOKPLOY.md.
EMAIL_FROM=BillingEase <hello@example.com>
SMTP_HOST=
# 465 = TLS from the start (default); 587 = STARTTLS (required, never plain text).
SMTP_PORT=465
# Optional: true/false to override what the port implies.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
POSTMARK_TOKEN=
# Files (logos, receipts, attachments, bank statements). On disk under STORAGE_DIR, unless
# S3_BUCKET is set: then in that bucket on any S3-compatible store (Silo, MinIO, AWS S3…).
STORAGE_DIR=.data/files
# e.g. https://silo.example.com (leave empty for AWS S3 itself).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. prod (to share one bucket between environments).
S3_PREFIX=
# Defaults to true when S3_ENDPOINT is set (<endpoint>/<bucket>); false for <bucket>.<endpoint>.
S3_FORCE_PATH_STYLE=
# AI: Ask and the agents run on Gemini through Vertex AI. Without GOOGLE_CLOUD_PROJECT they
# say they aren't set up. Sign in with `gcloud auth application-default login` locally, or a
# service account (GOOGLE_APPLICATION_CREDENTIALS) when hosted. No API keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_APPLICATION_CREDENTIALS=
# Model per tier (Google retires versions on a schedule: keep these current).
AI_MODEL_DEEP=gemini-4-argon
AI_MODEL_FAST=gemini-3.8-flash
AI_MODEL_LITE=gemini-3.5-flash-lite
# US dollars per million tokens, "input,output". Placeholders: set from the Vertex AI price list.
AI_PRICE_DEEP=2,12
AI_PRICE_FAST=0.3,2.5
AI_PRICE_LITE=0.1,0.4
# Default monthly AI spend cap per business, in US dollars (owners can set their own per agent).
AI_MONTHLY_BUDGET_USD=5
# Public API and MCP server: calls per business per day, and per token per minute.
API_DAILY_QUOTA=5000
API_RATE_PER_MINUTE=120
# Fix "today" for demos and tests (YYYY-MM-DD).
BILLINGEASE_TODAY=

# --- Web (apps/web) ---
API_URL=http://127.0.0.1:4000
